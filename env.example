# BotFather कडून मिळालेला टोकन (हा कोणालाही देऊ नका)
BOT_TOKEN=123456789:AAAbbbCCCdddEEE

# चॅनलचं युजरनेम @ सह. बॉट या चॅनलमध्ये ऍडमिन असला पाहिजे
CHANNEL_ID=@KnowYourCity

# तुमचा टेलिग्राम युजर आयडी (नंबर). @userinfobot ला मेसेज करून मिळतो. एकापेक्षा जास्त असतील तर स्वल्पविरामाने
ADMIN_IDS=123456789

# स्पर्धा कोणत्या तारखेपासून सुरू (या तारखेला दिवस १ धरला जातो आणि प्रश्न १ ते ५ येतात)
START_DATE=2026-10-27

# प्रश्नांची Google Sheet. Anyone with the link can view अशी शेअर केलेली
SHEET_URL=https://docs.google.com/spreadsheets/d/1JbJia_6bIlj73xjdgY3JiaCqAbYGQAGHgD297CJguf0/edit
SHEET_SYNC_MINUTES=10

# स्पॉन्सरची ओळ. नसेल तर रिकामी ठेवा
SPONSOR_TEXT=

# वेळा (२४ तास). सकाळी प्रश्न, दुपारी आठवण, रात्री उत्तरं
QUIZ_HOUR=8
REMIND_HOUR=15
RESULT_HOUR=21

# डेटा कुठे साठवायचा. Railway वर volume /data ला जोडा आणि इथं /data लिहा
DATA_DIR=/data
TZ_NAME=Asia/Kolkata
